# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 말고 채팅에도 올리지 않습니다.

# 1이면 AI를 부르지 않고 fixture 사건을 돌려준다 (로컬 기본값). 실제 AI로 시험할 때만 0
MOCK_AI=1

# memory | redis  — 로컬은 memory. Cloud DB for Cache는 사설망이라 로컬에서 붙을 수 없다.
STORE=memory

# AI 제공사: gemini(개발) | openai(배포)
AI_PROVIDER=gemini

# Gemini (개발용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (배포용, 서버만)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Cloud DB for Cache 사설 주소 (서버만), 예: redis://10.0.1.5:6379
REDIS_URL=

# 원문 계열 키 암호화용 32바이트 키(base64) (서버만)
ENCRYPTION_KEY=
